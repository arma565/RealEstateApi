  "components": {
    "schemas": {
      "Change": {
        "required": [
          "currentPassword",
          "newPassword",
          "repeatPassword",
          "userName"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "minLength": 1,
            "type": "string"
          },
          "currentPassword": {
            "minLength": 1,
            "type": "string",
            "format": "password"
          },
          "newPassword": {
            "minLength": 1,
            "type": "string",
            "format": "password"
          },
          "repeatPassword": {
            "minLength": 1,
            "type": "string",
            "format": "password"
          }
        },
        "additionalProperties": false
      },
      "Estate": {
        "required": [
          "address",
          "area",
          "constructionYear",
          "deposit",
          "name",
          "payment",
          "platesNumber",
          "price",
          "rentAmount",
          "type"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "platesNumber": {
            "minLength": 1,
            "type": "string"
          },
          "area": {
            "minLength": 1,
            "type": "string"
          },
          "constructionYear": {
            "minLength": 1,
            "type": "string"
          },
          "price": {
            "minLength": 1,
            "type": "string"
          },
          "deposit": {
            "minLength": 1,
            "type": "string"
          },
          "rentAmount": {
            "minLength": 1,
            "type": "string"
          },
          "payment": {
            "minLength": 1,
            "type": "string"
          },
          "address": {
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "time": {
            "type": "string",
            "nullable": true
          },
          "date": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "minLength": 1,
            "type": "string"
          },
          "water": {
            "type": "boolean"
          },
          "electricity": {
            "type": "boolean"
          },
          "gas": {
            "type": "boolean"
          },
          "phone": {
            "type": "boolean"
          },
          "persons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Person"
            },
            "nullable": true,
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "Login": {
        "required": [
          "password",
          "userName"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string",
            "format": "password"
          }
        },
        "additionalProperties": false
      },
      "Person": {
        "required": [
          "address",
          "birthCertificateNumber",
          "name",
          "personID",
          "phone"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "fatherName": {
            "type": "string",
            "nullable": true
          },
          "birthCertificateNumber": {
            "type": "integer",
            "format": "int64"
          },
          "birthCertificateIssued": {
            "type": "string",
            "nullable": true
          },
          "personID": {
            "type": "integer",
            "format": "int64"
          },
          "born": {
            "type": "string",
            "nullable": true
          },
          "address": {
            "minLength": 1,
            "type": "string"
          },
          "phone": {
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "type": "string",
            "nullable": true
          },
          "propertyID": {
            "type": "string",
            "format": "uuid"
          },
          "property": {
            "$ref": "#/components/schemas/Estate"
          }
        },
        "additionalProperties": false
      },
      "Profile": {
        "required": [
          "firstName",
          "lastName",
          "phoneNumber",
          "userName"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "minLength": 1,
            "type": "string"
          },
          "firstName": {
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "minLength": 1,
            "type": "string"
          },
          "phoneNumber": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Recovery": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          }
        },
        "additionalProperties": false
      },
      "Register": {
        "required": [
          "acceptTerms",
          "email",
          "password",
          "repeatPassword",
          "userName"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string",
            "format": "password"
          },
          "repeatPassword": {
            "minLength": 1,
            "type": "string",
            "format": "password"
          },
          "acceptTerms": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "Reset": {
        "required": [
          "email",
          "newPassword",
          "repeatNewPassword"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "token": {
            "type": "string",
            "nullable": true
          },
          "newPassword": {
            "minLength": 1,
            "type": "string",
            "format": "password"
          },
          "repeatNewPassword": {
            "minLength": 1,
            "type": "string",
            "format": "password"
          }
        },
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "profileImagePath": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "acceptTerms": {
            "type": "boolean",
            "nullable": true
          },
          "userName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
