  "components": {
    "schemas": {
      "Asset": {
        "required": [
          "address",
          "area",
          "constructionYear",
          "name",
          "payment",
          "platesNumber",
          "price",
          "type"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "orderID": {
            "type": "integer",
            "format": "int32",
            "default": 0
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "platesNumber": {
            "minLength": 1,
            "type": "string"
          },
          "area": {
            "minLength": 1,
            "type": "string"
          },
          "constructionYear": {
            "minLength": 1,
            "type": "string"
          },
          "price": {
            "minLength": 1,
            "type": "string"
          },
          "deposit": {
            "type": "string",
            "nullable": true
          },
          "rentAmount": {
            "type": "string",
            "nullable": true
          },
          "payment": {
            "minLength": 1,
            "type": "string"
          },
          "address": {
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "time": {
            "type": "string",
            "nullable": true
          },
          "date": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "minLength": 1,
            "type": "string"
          },
          "water": {
            "type": "boolean"
          },
          "electricity": {
            "type": "boolean"
          },
          "gas": {
            "type": "boolean"
          },
          "phone": {
            "type": "boolean"
          },
          "assetImages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssetImage"
            },
            "nullable": true,
            "readOnly": true
          },
          "persons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Person"
            },
            "nullable": true,
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "AssetImage": {
        "required": [
          "fileName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fileName": {
            "minLength": 1,
            "type": "string"
          },
          "assetID": {
            "type": "string",
            "format": "uuid"
          },
          "asset": {
            "$ref": "#/components/schemas/Asset"
          }
        },
        "additionalProperties": false
      },
      "Change": {
        "required": [
          "currentPassword",
          "newPassword",
          "repeatPassword",
          "userName"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "minLength": 1,
            "type": "string"
          },
          "currentPassword": {
            "minLength": 1,
            "type": "string",
            "format": "password"
          },
          "newPassword": {
            "minLength": 8,
            "type": "string",
            "format": "password"
          },
          "repeatPassword": {
            "minLength": 8,
            "type": "string",
            "format": "password"
          }
        },
        "additionalProperties": false
      },
      "Login": {
        "required": [
          "password",
          "userName"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 8,
            "type": "string",
            "format": "password"
          }
        },
        "additionalProperties": false
      },
      "Person": {
        "required": [
          "address",
          "birthCertificateNumber",
          "name",
          "personID",
          "phone"
        ],
        "type": "object",
        "properties": {
